# Copy to .env at the repository root. Set your own local database password.
APP_ENV=development
# PDF file limit (10 MiB), plus 64 KiB multipart envelope allowance at the HTTP boundary.
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=50
POSTGRES_DB=finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=replace-with-a-local-development-password
# Compose publishes this host port to the fixed PostgreSQL container port 5432.
POSTGRES_HOST_PORT=55433
# Client destination for host-run Python/Alembic. Match POSTGRES_HOST_PORT here.
# Compose overrides the backend's client destination to postgres:5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433
# Optional alternative for a host-run or standalone backend. When set, it replaces the
# split POSTGRES_* client fields and must use postgresql+psycopg. Keep credentials secret.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/finsight
# Published ports are bound to localhost by Compose.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# JSON list. Update these and VITE_API_BASE_URL if you change published ports.
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Generate a unique random value (at least 32 characters). Never reuse this placeholder.
AUTH_JWT_SECRET=replace-with-a-random-auth-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
# Keep false only for local HTTP. Production startup requires true and HTTPS origins.
AUTH_REFRESH_COOKIE_SECURE=false
# Browser-accessible URL, never a Docker service hostname. Public, not a secret.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Production image build uses this browser-visible, non-secret value.
# PUBLIC_API_BASE_URL=https://api.example.invalid/api/v1
# Optional backend-only assistant configuration. Never prefix secrets with VITE_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ASSISTANT_MAX_MESSAGE_CHARS=4000
ASSISTANT_MAX_HISTORY_MESSAGES=10
ASSISTANT_MAX_HISTORY_CHARS=12000
ASSISTANT_MAX_TOOL_ROUNDS=4
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_MAX_PROVIDER_CALLS=6
ASSISTANT_PROVIDER_TIMEOUT_SECONDS=20
ASSISTANT_MAX_OUTPUT_TOKENS=700
